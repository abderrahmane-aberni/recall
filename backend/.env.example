# Copy this file to backend/.env and fill in real values. .env is git-ignored.

# Required for chat answer generation (and for the "gemini" embedding backend).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# "gemini" (default here) = gemini-embedding-001, uses your Gemini API quota,
#           768 dims. This is what production (Render) runs, and it's set as
#           the local default too so local testing and the deployed app share
#           the same Neon database without a vector-dimension mismatch.
# "local"             = sentence-transformers all-MiniLM-L6-v2, free, CPU, 384
#           dims. Only use this with a SEPARATE database (or after dropping
#           the chunks table) - mixing 384-dim and 768-dim vectors in the same
#           table isn't just wrong, it fails outright (pgvector enforces the
#           column's fixed width). See README "Switching embedding backends".
#           Install backend/requirements-local.txt (adds sentence-transformers)
#           to use this option.
EMBEDDING_BACKEND=gemini
EMBEDDING_DIM=768

# Postgres connection string with the pgvector extension available (e.g. a free
# Neon.tech instance). Must be a real Postgres URL, not SQLite - pgvector similarity
# search needs the pgvector extension, which SQLite doesn't have.
# NOTE: this is the SAME database your Render deployment will use (see
# DEPLOY.md) - that's why EMBEDDING_BACKEND/EMBEDDING_DIM above must match
# whatever Render is configured with.
DATABASE_URL=

CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
RETRIEVAL_TOP_K=5

MAX_UPLOAD_MB=20

RATE_LIMIT_PER_IP_PER_HOUR=20
RATE_LIMIT_GLOBAL_PER_DAY=200
